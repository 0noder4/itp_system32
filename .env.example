# PROJECT CONFIGURATION
PROJECT_NAME=system_32
ENV=development # Options: development, production
FRONTEND_VERSION=0.0
BACKEND_VERSION=0.0

# DOCKER REGISTRY CONFIGURATION (Production only)
# Example: docker.io/yourusername or registry.example.com
DOCKER_REGISTRY=docker.io/0noder4

# DJANGO CONFIGURATION
DJANGO_SECRET_KEY=your_secret_key
DEBUG=True # True or False (MUST be False in production)
DJANGO_LOGLEVEL=info # info, warning, or error
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1 # Comma-separated list (e.g., example.com,api.example.com)

# CSRF CONFIGURATION (Production only)
# Comma-separated list of trusted origins for CSRF protection
# Should include your backend domain (for admin panel) and frontend domain
# Example: https://api.example.com,https://example.com
# If not set, will fallback to CORS_ALLOWED_ORIGINS
CSRF_TRUSTED_ORIGINS=

# CORS CONFIGURATION (Production only)
# Comma-separated list of allowed frontend origins
# Example: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# EMAIL CONFIGURATION
# For development, use mailpit service
# For production, use your SMTP server (Gmail, SendGrid, etc.)
EMAIL_HOST=mailpit # Use your SMTP host in production (e.g., smtp.gmail.com)
EMAIL_PORT=1025 # Use 587 for TLS or 465 for SSL in production
EMAIL_HOST_USER=dev # Your SMTP username in production
EMAIL_HOST_PASSWORD=dev # Your SMTP password in production
EMAIL_USE_SSL= # Set to True if using SSL (port 465)
EMAIL_USE_TLS= # Set to True if using TLS (port 587)
DEFAULT_FROM_EMAIL=noreply@targipracy.org.pl # Default sender email address

# DATABASE CONFIGURATION
DATABASE_HOST=db
DATABASE_NAME=system_32
DATABASE_USER=user
DATABASE_PASSWORD=your_password
DATABASE_ROOT_PASSWORD=your_password
DATABASE_PORT=3306
DATABASE_ENGINE=mysql

# APPLICATION URLs
# Frontend base URL - used for email links and redirects
FRONTEND_BASE_URL=http://localhost:3000 # Use https://yourdomain.com in production
BACKEND_BASE_URL=http://localhost:8000 # Use https://api.yourdomain.com in production

# API URL - full backend API URL (used by frontend)
# For production, use full URL: https://api.example.com or https://example.com/api
API_URL=http://localhost:8000

# DATABASE & MEDIA BACKUP CONFIGURATION
# MySQL backup schedule in crontab format (default: every 6 hours)
BACKUP_SCHEDULE=0 */6 * * *
# Number of days to retain DB backups and tagged backups (default: 30)
BACKUP_RETENTION_DAYS=30
# Mediafiles backup once per night (default: 02:30 Europe/Warsaw, 14 days retention)
MEDIA_BACKUP_ENABLED=true
MEDIA_BACKUP_SCHEDULE=30 2 * * *
MEDIA_BACKUP_RETENTION_DAYS=14
# Minimum required free disk space in GB before starting backup (default: 5)
BACKUP_MIN_FREE_GB=5
# Run backup immediately on container start (true/false)
BACKUP_ON_START=false
# Timezone for backup schedule (default: Europe/Warsaw)
TZ=Europe/Warsaw
# Optional fallback alert email (normally read from Settings.system_admin_email in Django Admin)
# BACKUP_ALERT_EMAIL=

# Google Drive off-site sync via rclone (Shared Drive + Service Account JSON in ./backups/secrets/gdrive-sa.json)
GDRIVE_SYNC_ENABLED=false
GDRIVE_SHARED_DRIVE_ID=
GDRIVE_SERVICE_ACCOUNT_FILE=/secrets/gdrive-sa.json
GDRIVE_EXPORTS_SYNC_SCHEDULE=5 3 * * *
GDRIVE_MEDIA_ARCHIVE_RETENTION_DAYS=30

# Nightly emergency .xlsx & PNG map export (5 sheet files + map .xlsx + 10 PNG maps, Europe/Warsaw)
EMERGENCY_EXPORT_ENABLED=true
EMERGENCY_EXPORT_HOUR=2
EMERGENCY_EXPORT_MINUTE=45
EXPORT_RETENTION_DAYS=7

# Invitation expiry reminder scheduler (Europe/Warsaw clock inside the loop)
NOTIFICATIONS_HOUR=9
NOTIFICATIONS_MINUTE=0

# Strapi / targus website catalogue export (staff → draft in CMS)
# Production: https://api.targipracy.org.pl
# Local Docker (system32 container → host Targus): http://host.docker.internal:1337
STRAPI_URL=
STRAPI_API_TOKEN=
# STRAPI_CONNECT_TIMEOUT=10
# STRAPI_READ_TIMEOUT=60
# WEBSITE_EXPORT_BATCH_MAX=10