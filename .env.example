# PROJECT CONFIGURATION
PROJECT_NAME=system_32
ENV=development # Options: development, production
FRONTEND_VERSION=0.0
BACKEND_VERSION=0.0

# DOCKER REGISTRY CONFIGURATION (Production only)
# Example: docker.io/yourusername or registry.example.com
DOCKER_REGISTRY=docker.io/0noder4

# DJANGO CONFIGURATION
DJANGO_SECRET_KEY=your_secret_key
DEBUG=True # True or False (MUST be False in production)
DJANGO_LOGLEVEL=info # info, warning, or error
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1 # Comma-separated list (e.g., example.com,api.example.com)

# CORS CONFIGURATION (Production only)
# Comma-separated list of allowed frontend origins
# Example: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# EMAIL CONFIGURATION
# For development, use mailpit service
# For production, use your SMTP server (Gmail, SendGrid, etc.)
EMAIL_HOST=mailpit # Use your SMTP host in production (e.g., smtp.gmail.com)
EMAIL_PORT=1025 # Use 587 for TLS or 465 for SSL in production
EMAIL_HOST_USER=dev # Your SMTP username in production
EMAIL_HOST_PASSWORD=dev # Your SMTP password in production
EMAIL_USE_SSL= # Set to True if using SSL (port 465)
EMAIL_USE_TLS= # Set to True if using TLS (port 587)
DEFAULT_FROM_EMAIL=noreply@targipracy.org.pl # Default sender email address

# DATABASE CONFIGURATION
DATABASE_HOST=db
DATABASE_NAME=system_32
DATABASE_USER=user
DATABASE_PASSWORD=your_password
DATABASE_ROOT_PASSWORD=your_password
DATABASE_PORT=3306
DATABASE_ENGINE=mysql

# APPLICATION URLs
# Frontend base URL - used for email links and redirects
FRONTEND_BASE_URL=http://localhost:3000 # Use https://yourdomain.com in production

# API URL - full backend API URL (used by frontend)
# For production, use full URL: https://api.example.com or https://example.com/api
API_URL=http://localhost:8000